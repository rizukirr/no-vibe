{
  "name": "no-vibe",
  "version": "3.2.0",
  "description": "Learning mode for AI coding assistants. The agent teaches and shows code in chat, and you type every line yourself.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "rizukirr",
    "url": "https://github.com/rizukirr"
  },
  "homepage": "https://github.com/rizukirr/no-vibe#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rizukirr/no-vibe.git"
  },
  "bugs": {
    "url": "https://github.com/rizukirr/no-vibe/issues"
  },
  "keywords": [
    "pi-package",
    "opencode-plugin",
    "claude-code-plugin",
    "codex-plugin",
    "antigravity-plugin",
    "ai-tutor",
    "no-vibe",
    "learning",
    "education"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "node bin/generate.mjs",
    "check": "node bin/generate.mjs --check"
  },
  "files": [
    ".agents/",
    ".claude-plugin/",
    ".codex-plugin/",
    ".opencode/",
    ".pi-plugin/",
    "AGENTS.md",
    "INSTALL.codex.md",
    "INSTALL.pi.md",
    "LICENSE",
    "README.md",
    "commands/",
    "hooks.json",
    "hooks/",
    "plugin.json",
    "rules/",
    "skills/"
  ],
  "main": "./.opencode/plugins/no-vibe.js",
  "pi": {
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./.pi-plugin/prompts"
    ],
    "extensions": [
      "./.pi-plugin/extensions"
    ]
  }
}
